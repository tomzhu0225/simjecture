{
  "$defs": {
    "EngineeringAdjudicationStatus": {
      "enum": [
        "accepted",
        "counterexample",
        "rejected"
      ],
      "title": "EngineeringAdjudicationStatus",
      "type": "string"
    },
    "EngineeringCheckResult": {
      "additionalProperties": false,
      "description": "Bounded receipt for one command execution.",
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/EngineeringCheckStage"
        },
        "status": {
          "$ref": "#/$defs/EngineeringCheckStatus"
        },
        "stderr": {
          "title": "Stderr",
          "type": "string"
        },
        "stderr_sha256": {
          "title": "Stderr Sha256",
          "type": "string"
        },
        "stdout": {
          "title": "Stdout",
          "type": "string"
        },
        "stdout_sha256": {
          "title": "Stdout Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "stage",
        "command",
        "status",
        "exit_code",
        "duration_seconds",
        "stdout",
        "stderr",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "title": "EngineeringCheckResult",
      "type": "object"
    },
    "EngineeringCheckStage": {
      "enum": [
        "commissioning",
        "targeted",
        "full",
        "holdout"
      ],
      "title": "EngineeringCheckStage",
      "type": "string"
    },
    "EngineeringCheckStatus": {
      "enum": [
        "passed",
        "failed",
        "timed_out"
      ],
      "title": "EngineeringCheckStatus",
      "type": "string"
    },
    "EngineeringDiffReview": {
      "additionalProperties": false,
      "description": "A deterministic review of the exact committed patch, independent of CI.",
      "properties": {
        "changed_paths": {
          "items": {
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "commit": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Commit",
          "type": "string"
        },
        "diff_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diff Sha256",
          "type": "string"
        },
        "parent_commit": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Parent Commit",
          "type": "string"
        },
        "patch_id": {
          "title": "Patch Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/EngineeringDiffReviewStatus"
        },
        "violations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "patch_id",
        "commit",
        "parent_commit",
        "diff_sha256",
        "changed_paths",
        "status",
        "reviewer"
      ],
      "title": "EngineeringDiffReview",
      "type": "object"
    },
    "EngineeringDiffReviewStatus": {
      "enum": [
        "accepted",
        "rejected"
      ],
      "title": "EngineeringDiffReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Final host-side verdict combining hidden checks and diff review.",
  "properties": {
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "checks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EngineeringCheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diff_review": {
      "$ref": "#/$defs/EngineeringDiffReview"
    },
    "failure_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Reason"
    },
    "holdout_base_commit": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Holdout Base Commit",
      "type": "string"
    },
    "holdout_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Holdout Contract Sha256",
      "type": "string"
    },
    "holdout_id": {
      "title": "Holdout Id",
      "type": "string"
    },
    "patch_commit": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Patch Commit",
      "type": "string"
    },
    "patch_id": {
      "title": "Patch Id",
      "type": "string"
    },
    "reviewer": {
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/EngineeringAdjudicationStatus"
    }
  },
  "required": [
    "campaign_id",
    "patch_id",
    "patch_commit",
    "holdout_id",
    "holdout_contract_sha256",
    "holdout_base_commit",
    "diff_review",
    "status",
    "reviewer"
  ],
  "title": "EngineeringAdjudicationRecord",
  "type": "object"
}
