{
  "$defs": {
    "EngineeringCheckStage": {
      "enum": [
        "commissioning",
        "targeted",
        "full",
        "holdout"
      ],
      "title": "EngineeringCheckStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One shell-free command in the immutable acceptance contract.",
  "properties": {
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/EngineeringCheckStage",
      "default": "full"
    },
    "timeout_seconds": {
      "default": 900.0,
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Timeout Seconds",
      "type": "number"
    }
  },
  "required": [
    "name",
    "command"
  ],
  "title": "EngineeringCheck",
  "type": "object"
}
