{
  "$defs": {
    "ParameterDefinition": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "number"
        },
        "refinement_direction": {
          "$ref": "#/$defs/RefinementDirection",
          "default": "none"
        },
        "refinement_factor": {
          "default": 2.0,
          "exclusiveMinimum": 1,
          "title": "Refinement Factor",
          "type": "number"
        },
        "role": {
          "$ref": "#/$defs/ParameterRole"
        },
        "scale": {
          "$ref": "#/$defs/ParameterScale"
        },
        "units": {
          "default": "dimensionless",
          "title": "Units",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "name",
        "role",
        "scale",
        "lower",
        "upper",
        "reference"
      ],
      "title": "ParameterDefinition",
      "type": "object"
    },
    "ParameterRole": {
      "enum": [
        "physical",
        "numerical"
      ],
      "title": "ParameterRole",
      "type": "string"
    },
    "ParameterScale": {
      "enum": [
        "linear",
        "log",
        "integer"
      ],
      "title": "ParameterScale",
      "type": "string"
    },
    "ReferenceQualification": {
      "additionalProperties": false,
      "properties": {
        "diagnostics_hashes": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Diagnostics Hashes",
          "type": "array"
        },
        "qualification_attempt_id": {
          "minLength": 1,
          "title": "Qualification Attempt Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "smoke_attempt_id": {
          "minLength": 1,
          "title": "Smoke Attempt Id",
          "type": "string"
        }
      },
      "required": [
        "smoke_attempt_id",
        "qualification_attempt_id",
        "diagnostics_hashes"
      ],
      "title": "ReferenceQualification",
      "type": "object"
    },
    "RefinementDirection": {
      "enum": [
        "none",
        "increase",
        "decrease"
      ],
      "title": "RefinementDirection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "max_autonomous_failures": {
      "default": 2,
      "minimum": 0,
      "title": "Max Autonomous Failures",
      "type": "integer"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/ParameterDefinition"
      },
      "minItems": 1,
      "title": "Parameters",
      "type": "array"
    },
    "reference_qualification": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReferenceQualification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "parameters"
  ],
  "title": "ParameterSpace",
  "type": "object"
}
