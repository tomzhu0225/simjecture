{
  "$defs": {
    "CostEstimate": {
      "additionalProperties": false,
      "properties": {
        "compute_units": {
          "minimum": 0,
          "title": "Compute Units",
          "type": "number"
        },
        "storage_bytes": {
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "compute_units",
        "wall_seconds",
        "storage_bytes"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "ResearchToolKind": {
      "enum": [
        "simulator",
        "analysis",
        "verifier",
        "literature_search"
      ],
      "title": "ResearchToolKind",
      "type": "string"
    },
    "ResearchToolManifest": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "idempotent": {
          "const": true,
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ResearchToolKind"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "supported_coordinates": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Coordinates",
          "type": "array"
        },
        "supported_model_families": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Model Families",
          "type": "array"
        },
        "supported_observables": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Observables",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "description",
        "kind",
        "input_schema",
        "output_schema",
        "supported_model_families"
      ],
      "title": "ResearchToolManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Command",
      "type": "array"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "estimated_cost": {
      "$ref": "#/$defs/CostEstimate"
    },
    "manifest": {
      "$ref": "#/$defs/ResearchToolManifest"
    },
    "timeout_seconds": {
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "working_directory": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Working Directory"
    }
  },
  "required": [
    "manifest",
    "command",
    "timeout_seconds",
    "estimated_cost"
  ],
  "title": "SubprocessResearchToolConfig",
  "type": "object"
}
