{
  "$defs": {
    "WarpXConfirmationResolution": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_interval_steps": {
          "minimum": 1,
          "title": "Diagnostic Interval Steps",
          "type": "integer"
        },
        "electron_macroparticles_per_cell": {
          "minimum": 16,
          "title": "Electron Macroparticles Per Cell",
          "type": "integer"
        },
        "grid_cells": {
          "minimum": 32,
          "title": "Grid Cells",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "time_step_omega_pe": {
          "exclusiveMinimum": 0,
          "title": "Time Step Omega Pe",
          "type": "number"
        }
      },
      "required": [
        "id",
        "grid_cells",
        "electron_macroparticles_per_cell",
        "time_step_omega_pe",
        "diagnostic_interval_steps"
      ],
      "title": "WarpXConfirmationResolution",
      "type": "object"
    },
    "WarpXPhysicalConfig": {
      "additionalProperties": false,
      "properties": {
        "inner_drift": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Inner Drift",
          "type": "number"
        },
        "inner_pair_weight": {
          "default": 0.5,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Inner Pair Weight",
          "type": "number"
        },
        "outer_drift": {
          "default": 0.95,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Outer Drift",
          "type": "number"
        },
        "perturbation_amplitude": {
          "default": 0.02,
          "maximum": 0.05,
          "minimum": 1e-07,
          "title": "Perturbation Amplitude",
          "type": "number"
        },
        "reference_density_m3": {
          "default": 1e+18,
          "maximum": 1e+25,
          "minimum": 1000000000000.0,
          "title": "Reference Density M3",
          "type": "number"
        },
        "velocity_unit_m_s": {
          "default": 1000000.0,
          "maximum": 20000000.0,
          "minimum": 1000.0,
          "title": "Velocity Unit M S",
          "type": "number"
        },
        "wavenumber_dimensionless": {
          "default": 0.5,
          "maximum": 2.0,
          "minimum": 0.1,
          "title": "Wavenumber Dimensionless",
          "type": "number"
        }
      },
      "title": "WarpXPhysicalConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "physical": {
      "$ref": "#/$defs/WarpXPhysicalConfig"
    },
    "qualification_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qualification Hash",
      "type": "string"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/WarpXConfirmationResolution"
      },
      "minItems": 2,
      "title": "Resolutions",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seeds": {
      "default": [
        211,
        307,
        401
      ],
      "items": {
        "type": "integer"
      },
      "minItems": 3,
      "title": "Seeds",
      "type": "array"
    },
    "selection_frozen_before_confirmation": {
      "const": true,
      "default": true,
      "title": "Selection Frozen Before Confirmation",
      "type": "boolean"
    }
  },
  "required": [
    "qualification_hash",
    "physical",
    "resolutions"
  ],
  "title": "WarpXConfirmationDesign",
  "type": "object"
}
