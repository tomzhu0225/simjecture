      "title": "Expected Warpx Version",
      "type": "string"
    },
    "host_architecture": {
      "title": "Host Architecture",
      "type": "string"
    },
    "observed_warpx_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Warpx Version"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
