{
  "$defs": {
    "AttemptOutcome": {
      "enum": [
        "success",
        "infrastructure_failure",
        "specification_failure",
        "numerical_failure",
        "validity_failure",
        "interrupted"
      ],
      "title": "AttemptOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "external_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Job Id"
    },
    "failure_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    }
  },
  "required": [
    "experiment_id",
    "idempotency_key"
  ],
  "title": "AttemptRecord",
  "type": "object"
}
