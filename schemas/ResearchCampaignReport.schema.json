{
  "$defs": {
    "CandidateResult": {
      "additionalProperties": false,
      "properties": {
        "contradicting_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence Ids",
          "type": "array"
        },
        "formal_specification": {
          "additionalProperties": true,
          "title": "Formal Specification",
          "type": "object"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "novelty_status": {
          "$ref": "#/$defs/NoveltyStatus",
          "default": "unassessed"
        },
        "result_class": {
          "$ref": "#/$defs/ResearchResultClass"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "supporting_evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "hypothesis_id",
        "result_class",
        "statement",
        "formal_specification",
        "scope",
        "supporting_evidence_ids",
        "limitations"
      ],
      "title": "CandidateResult",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "properties": {
        "compute_units": {
          "minimum": 0,
          "title": "Compute Units",
          "type": "number"
        },
        "storage_bytes": {
          "minimum": 0,
          "title": "Storage Bytes",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "compute_units",
        "wall_seconds",
        "storage_bytes"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "EvidenceRole": {
      "enum": [
        "discovery",
        "confirmation",
        "qualification"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "HypothesisOrigin": {
      "enum": [
        "human",
        "ai",
        "mixed"
      ],
      "title": "HypothesisOrigin",
      "type": "string"
    },
    "NoveltyStatus": {
      "enum": [
        "unassessed",
        "known_result",
        "candidate_new",
        "verified_new"
      ],
      "title": "NoveltyStatus",
      "type": "string"
    },
    "ObservablePrediction": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        },
        "exact": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "observable": {
          "minLength": 1,
          "title": "Observable",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "observable",
        "condition"
      ],
      "title": "ObservablePrediction",
      "type": "object"
    },
    "ProposedToolCall": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "evidence_role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "evidence_stage": {
          "$ref": "#/$defs/ResearchEvidenceStage"
        },
        "falsification_condition": {
          "minLength": 1,
          "title": "Falsification Condition",
          "type": "string"
        },
        "independence_group": {
          "minLength": 1,
          "title": "Independence Group",
          "type": "string"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/ObservablePrediction"
          },
          "minItems": 1,
          "title": "Predictions",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "tool_name": {
          "minLength": 1,
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "tool_name",
        "arguments",
        "purpose",
        "evidence_stage",
        "evidence_role",
        "independence_group",
        "predictions",
        "falsification_condition"
      ],
      "title": "ProposedToolCall",
      "type": "object"
    },
    "ResearchBudget": {
      "additionalProperties": false,
      "properties": {
        "maximum_compute_units": {
          "exclusiveMinimum": 0,
          "title": "Maximum Compute Units",
          "type": "number"
        },
        "maximum_iterations": {
          "minimum": 1,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "maximum_storage_bytes": {
          "exclusiveMinimum": 0,
          "title": "Maximum Storage Bytes",
          "type": "integer"
        },
        "maximum_tool_calls": {
          "minimum": 0,
          "title": "Maximum Tool Calls",
          "type": "integer"
        },
        "maximum_wall_seconds": {
          "exclusiveMinimum": 0,
          "title": "Maximum Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "maximum_iterations",
        "maximum_tool_calls",
        "maximum_compute_units",
        "maximum_wall_seconds",
        "maximum_storage_bytes"
      ],
      "title": "ResearchBudget",
      "type": "object"
    },
    "ResearchConclusion": {
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disposition": {
          "$ref": "#/$defs/ResearchDisposition"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "disposition",
        "reason"
      ],
      "title": "ResearchConclusion",
      "type": "object"
    },
    "ResearchDecision": {
      "additionalProperties": false,
      "description": "One model-authored transition, committed before any tool execution.",
      "properties": {
        "conclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchConclusion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "iteration": {
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/ResearchDecisionKind"
        },
        "new_hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResearchHypothesis"
          },
          "title": "New Hypotheses",
          "type": "array"
        },
        "new_relations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResearchRelation"
          },
          "title": "New Relations",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_call": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProposedToolCall"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "iteration",
        "kind",
        "rationale"
      ],
      "title": "ResearchDecision",
      "type": "object"
    },
    "ResearchDecisionKind": {
      "enum": [
        "use_tool",
        "conclude"
      ],
      "title": "ResearchDecisionKind",
      "type": "string"
    },
    "ResearchDisposition": {
      "enum": [
        "validated_within_tools",
        "bounded_null",
        "insufficient_evidence",
        "budget_exhausted"
      ],
      "title": "ResearchDisposition",
      "type": "string"
    },
    "ResearchEvidencePolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_bounded_null": {
          "default": true,
          "title": "Allow Bounded Null",
          "type": "boolean"
        },
        "minimum_independent_confirmations": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Independent Confirmations",
          "type": "integer"
        },
        "preregistration_required": {
          "const": true,
          "default": true,
          "title": "Preregistration Required",
          "type": "boolean"
        },
        "require_deliberate_falsification": {
          "default": true,
          "title": "Require Deliberate Falsification",
          "type": "boolean"
        },
        "require_numerical_validity": {
          "const": true,
          "default": true,
          "title": "Require Numerical Validity",
          "type": "boolean"
        }
      },
      "title": "ResearchEvidencePolicy",
      "type": "object"
    },
    "ResearchEvidenceStage": {
      "enum": [
        "exploration",
        "qualification",
        "confirmation",
        "falsification"
      ],
      "title": "ResearchEvidenceStage",
      "type": "string"
    },
    "ResearchHypothesis": {
      "additionalProperties": false,
      "description": "Open scientific proposition whose details are authored during the run.",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "coordinates": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "formal_specification": {
          "additionalProperties": true,
          "title": "Formal Specification",
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "machine_predicate": {
          "minLength": 1,
          "title": "Machine Predicate",
          "type": "string"
        },
        "model_family": {
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "motivating_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Motivating Evidence Ids",
          "type": "array"
        },
        "observables": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observables",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/HypothesisOrigin"
        },
        "parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "proposition_class": {
          "$ref": "#/$defs/ResearchPropositionClass"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "id",
        "statement",
        "machine_predicate",
        "formal_specification",
        "proposition_class",
        "model_family",
        "scope",
        "coordinates",
        "observables",
        "origin"
      ],
      "title": "ResearchHypothesis",
      "type": "object"
    },
    "ResearchObservation": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "evidence_eligible": {
          "title": "Evidence Eligible",
          "type": "boolean"
        },
        "evidence_role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "evidence_stage": {
          "$ref": "#/$defs/ResearchEvidenceStage"
        },
        "hypothesis_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Hypothesis Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "independence_group": {
          "title": "Independence Group",
          "type": "string"
        },
        "iteration": {
          "minimum": 0,
          "title": "Iteration",
          "type": "integer"
        },
        "prediction_checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Prediction Checks",
          "type": "object"
        },
        "preregistered_predictions": {
          "items": {
            "$ref": "#/$defs/ObservablePrediction"
          },
          "minItems": 1,
          "title": "Preregistered Predictions",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/ResearchToolResult"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "iteration",
        "decision_id",
        "tool_name",
        "evidence_stage",
        "evidence_role",
        "independence_group",
        "hypothesis_ids",
        "preregistered_predictions",
        "prediction_checks",
        "result",
        "evidence_eligible"
      ],
      "title": "ResearchObservation",
      "type": "object"
    },
    "ResearchProblemContract": {
      "additionalProperties": false,
      "description": "Human direction and constitution, without a prescribed research path.",
      "properties": {
        "allowed_model_families": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Model Families",
          "type": "array"
        },
        "allowed_result_classes": {
          "items": {
            "$ref": "#/$defs/ResearchResultClass"
          },
          "minItems": 1,
          "title": "Allowed Result Classes",
          "type": "array"
        },
        "allowed_tools": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowed Tools",
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/ResearchBudget"
        },
        "evidence_policy": {
          "$ref": "#/$defs/ResearchEvidencePolicy"
        },
        "forbidden_shortcuts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Shortcuts",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "maximum_invalid_decisions_per_iteration": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Maximum Invalid Decisions Per Iteration",
          "type": "integer"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "root_hypotheses": {
          "items": {
            "$ref": "#/$defs/ResearchHypothesis"
          },
          "minItems": 1,
          "title": "Root Hypotheses",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scientific_constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scientific Constraints",
          "type": "array"
        },
        "significance": {
          "minLength": 1,
          "title": "Significance",
          "type": "string"
        }
      },
      "required": [
        "id",
        "question",
        "significance",
        "root_hypotheses",
        "allowed_result_classes",
        "allowed_model_families",
        "allowed_tools",
        "budget"
      ],
      "title": "ResearchProblemContract",
      "type": "object"
    },
    "ResearchPropositionClass": {
      "enum": [
        "contribution",
        "sufficiency",
        "invariance",
        "threshold",
        "path_dependence",
        "scaling_law",
        "phase_boundary",
        "closure",
        "auxiliary_validity"
      ],
      "title": "ResearchPropositionClass",
      "type": "string"
    },
    "ResearchRelation": {
      "additionalProperties": false,
      "properties": {
        "evidence_rule": {
          "minLength": 1,
          "title": "Evidence Rule",
          "type": "string"
        },
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResearchRelationKind"
        },
        "source_hypothesis_id": {
          "title": "Source Hypothesis Id",
          "type": "string"
        },
        "target_hypothesis_id": {
          "title": "Target Hypothesis Id",
          "type": "string"
        }
      },
      "required": [
        "source_hypothesis_id",
        "target_hypothesis_id",
        "kind",
        "evidence_rule",
        "justification"
      ],
      "title": "ResearchRelation",
      "type": "object"
    },
    "ResearchRelationKind": {
      "enum": [
        "specializes",
        "predicted_by",
        "tests",
        "alternative_to",
        "repairs",
        "auxiliary_to",
        "requires",
        "incompatible_with"
      ],
      "title": "ResearchRelationKind",
      "type": "string"
    },
    "ResearchResultClass": {
      "enum": [
        "counterexample",
        "scaling_law",
        "phase_boundary",
        "closure",
        "impossibility",
        "bounded_null"
      ],
      "title": "ResearchResultClass",
      "type": "string"
    },
    "ResearchToolResult": {
      "additionalProperties": false,
      "properties": {
        "artifact_hashes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifact Hashes",
          "type": "array"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "cost": {
          "$ref": "#/$defs/CostEstimate"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        },
        "failure_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Detail"
        },
        "observables": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Observables",
          "type": "object"
        },
        "scientific_scope": {
          "minLength": 1,
          "title": "Scientific Scope",
          "type": "string"
        },
        "validity_checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Validity Checks",
          "type": "object"
        }
      },
      "required": [
        "completed",
        "cost",
        "scientific_scope"
      ],
      "title": "ResearchToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_overrun": {
      "title": "Budget Overrun",
      "type": "boolean"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "conclusion": {
      "$ref": "#/$defs/ResearchConclusion"
    },
    "consumed_compute_units": {
      "minimum": 0,
      "title": "Consumed Compute Units",
      "type": "number"
    },
    "consumed_storage_bytes": {
      "minimum": 0,
      "title": "Consumed Storage Bytes",
      "type": "integer"
    },
    "consumed_tool_calls": {
      "minimum": 0,
      "title": "Consumed Tool Calls",
      "type": "integer"
    },
    "consumed_wall_seconds": {
      "minimum": 0,
      "title": "Consumed Wall Seconds",
      "type": "number"
    },
    "contract": {
      "$ref": "#/$defs/ResearchProblemContract"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/ResearchDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/ResearchHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ResearchObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "package_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Package Hash",
      "type": "string"
    },
    "package_kind": {
      "const": "universal_research_campaign",
      "default": "universal_research_campaign",
      "title": "Package Kind",
      "type": "string"
    },
    "provenance_event_hashes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Event Hashes",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/ResearchRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "contract",
    "hypotheses",
    "relations",
    "decisions",
    "observations",
    "conclusion",
    "consumed_tool_calls",
    "consumed_compute_units",
    "consumed_wall_seconds",
    "consumed_storage_bytes",
    "budget_overrun",
    "provenance_event_hashes",
    "generated_at",
    "package_hash"
  ],
  "title": "ResearchCampaignReport",
  "type": "object"
}
