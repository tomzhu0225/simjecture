{
  "$defs": {
    "DistributionMoments": {
      "additionalProperties": false,
      "properties": {
        "density": {
          "title": "Density",
          "type": "number"
        },
        "mean_velocity": {
          "title": "Mean Velocity",
          "type": "number"
        },
        "variance": {
          "minimum": 0,
          "title": "Variance",
          "type": "number"
        }
      },
      "required": [
        "density",
        "mean_velocity",
        "variance"
      ],
      "title": "DistributionMoments",
      "type": "object"
    },
    "DomainSpec": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fixed_parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Fixed Parameters",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "model_family": {
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "description",
        "model_family"
      ],
      "title": "DomainSpec",
      "type": "object"
    },
    "EvidenceContract": {
      "additionalProperties": false,
      "properties": {
        "falsifying_witness": {
          "minLength": 1,
          "title": "Falsifying Witness",
          "type": "string"
        },
        "minimum_independent_confirmation_attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Independent Confirmation Attempts",
          "type": "integer"
        },
        "primary_observable_id": {
          "title": "Primary Observable Id",
          "type": "string"
        },
        "primary_tolerance": {
          "exclusiveMinimum": 0,
          "title": "Primary Tolerance",
          "type": "number"
        }
      },
      "required": [
        "primary_observable_id",
        "falsifying_witness",
        "primary_tolerance"
      ],
      "title": "EvidenceContract",
      "type": "object"
    },
    "GaussianComponent": {
      "additionalProperties": false,
      "properties": {
        "drift": {
          "title": "Drift",
          "type": "number"
        },
        "sigma": {
          "exclusiveMinimum": 0,
          "title": "Sigma",
          "type": "number"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "weight",
        "drift",
        "sigma"
      ],
      "title": "GaussianComponent",
      "type": "object"
    },
    "GaussianMixture": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/GaussianComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "GaussianMixture",
      "type": "object"
    },
    "HypothesisNode": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "type": "string"
          },
          "title": "Coordinates",
          "type": "array"
        },
        "domain": {
          "$ref": "#/$defs/DomainSpec"
        },
        "evidence_contract": {
          "$ref": "#/$defs/EvidenceContract"
        },
        "formal_predicate": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchedPairFormalPredicate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "machine_predicate": {
          "minLength": 1,
          "title": "Machine Predicate",
          "type": "string"
        },
        "motivating_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Motivating Evidence Ids",
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/HypothesisOrigin"
        },
        "parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "proposition_class": {
          "$ref": "#/$defs/PropositionClass"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "machine_predicate",
        "proposition_class",
        "domain",
        "coordinates",
        "evidence_contract",
        "origin"
      ],
      "title": "HypothesisNode",
      "type": "object"
    },
    "HypothesisOrigin": {
      "enum": [
        "human",
        "ai",
        "mixed"
      ],
      "title": "HypothesisOrigin",
      "type": "string"
    },
    "KineticCaseResult": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "title": "Classification",
          "type": "string"
        },
        "distribution": {
          "$ref": "#/$defs/GaussianMixture"
        },
        "mode": {
          "$ref": "#/$defs/LinearMode"
        },
        "moments": {
          "$ref": "#/$defs/DistributionMoments"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "distribution",
        "moments",
        "mode",
        "classification"
      ],
      "title": "KineticCaseResult",
      "type": "object"
    },
    "LinearMode": {
      "additionalProperties": false,
      "properties": {
        "dielectric_residual": {
          "minimum": 0,
          "title": "Dielectric Residual",
          "type": "number"
        },
        "frequency": {
          "title": "Frequency",
          "type": "number"
        },
        "growth_rate": {
          "title": "Growth Rate",
          "type": "number"
        }
      },
      "required": [
        "frequency",
        "growth_rate",
        "dielectric_residual"
      ],
      "title": "LinearMode",
      "type": "object"
    },
    "MatchedPairFormalPredicate": {
      "additionalProperties": false,
      "description": "Executable semantics for a finite predictive-sufficiency witness.",
      "properties": {
        "coordinate_tolerance": {
          "default": 1e-10,
          "minimum": 0,
          "title": "Coordinate Tolerance",
          "type": "number"
        },
        "matched_coordinates": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Matched Coordinates",
          "type": "array"
        },
        "maximum_outcome_difference": {
          "exclusiveMinimum": 0,
          "title": "Maximum Outcome Difference",
          "type": "number"
        },
        "outcome_observable_id": {
          "minLength": 1,
          "title": "Outcome Observable Id",
          "type": "string"
        },
        "predicate_type": {
          "const": "matched_pair_predictive_sufficiency",
          "default": "matched_pair_predictive_sufficiency",
          "title": "Predicate Type",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "matched_coordinates",
        "outcome_observable_id",
        "maximum_outcome_difference"
      ],
      "title": "MatchedPairFormalPredicate",
      "type": "object"
    },
    "ObservableSpec": {
      "additionalProperties": false,
      "properties": {
        "estimator": {
          "minLength": 1,
          "title": "Estimator",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mathematical_definition": {
          "minLength": 1,
          "title": "Mathematical Definition",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "semantic_kind": {
          "minLength": 1,
          "title": "Semantic Kind",
          "type": "string"
        },
        "tolerance": {
          "exclusiveMinimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "units": {
          "default": "dimensionless",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "name",
        "semantic_kind",
        "mathematical_definition",
        "estimator",
        "tolerance"
      ],
      "title": "ObservableSpec",
      "type": "object"
    },
    "PropositionClass": {
      "enum": [
        "existential_contribution",
        "universal_non_contribution",
        "predictive_sufficiency",
        "causal_exhaustiveness",
        "invariance",
        "threshold",
        "path_dependence"
      ],
      "title": "PropositionClass",
      "type": "string"
    },
    "SufficiencyWitness": {
      "additionalProperties": false,
      "properties": {
        "coordinates_match": {
          "title": "Coordinates Match",
          "type": "boolean"
        },
        "falsifies": {
          "title": "Falsifies",
          "type": "boolean"
        },
        "hypothesis_id": {
          "title": "Hypothesis Id",
          "type": "string"
        },
        "left_evidence_id": {
          "title": "Left Evidence Id",
          "type": "string"
        },
        "outcome_separation": {
          "title": "Outcome Separation",
          "type": "number"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_separation": {
          "title": "Required Separation",
          "type": "number"
        },
        "right_evidence_id": {
          "title": "Right Evidence Id",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "left_evidence_id",
        "right_evidence_id",
        "coordinates_match",
        "outcome_separation",
        "required_separation",
        "falsifies",
        "reason"
      ],
      "title": "SufficiencyWitness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "experiment_id": {
      "default": "planted_kinetic_sufficiency_v1",
      "title": "Experiment Id",
      "type": "string"
    },
    "hypothesis": {
      "$ref": "#/$defs/HypothesisNode"
    },
    "maxwellian": {
      "$ref": "#/$defs/KineticCaseResult"
    },
    "moments_match": {
      "title": "Moments Match",
      "type": "boolean"
    },
    "observable": {
      "$ref": "#/$defs/ObservableSpec"
    },
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "two_stream": {
      "$ref": "#/$defs/KineticCaseResult"
    },
    "wavenumber": {
      "exclusiveMinimum": 0,
      "title": "Wavenumber",
      "type": "number"
    },
    "witness": {
      "$ref": "#/$defs/SufficiencyWitness"
    }
  },
  "required": [
    "hypothesis",
    "observable",
    "wavenumber",
    "maxwellian",
    "two_stream",
    "moments_match",
    "witness"
  ],
  "title": "KineticSufficiencyResult",
  "type": "object"
}
