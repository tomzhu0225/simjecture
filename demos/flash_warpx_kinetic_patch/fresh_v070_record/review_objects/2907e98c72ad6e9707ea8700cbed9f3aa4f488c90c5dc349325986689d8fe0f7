": {"bytes": 429, "included_inline": true, "path": "review_objects/cd6c4db946c144a2f5bc86c877e929c7f7ecd334ced012da9153ea43c5546823", "read_only": true, "sha256": "cd6c4db946c144a2f5bc86c877e929c7f7ecd334ced012da9153ea43c5546823"}, "estimator.py": {"bytes": 1878, "included_inline": true, "path": "review_objects/44e914ad2780edabf2754f4fae734fd9b5811d6d8b5db094e57f6e379d0be0d4", "read_only": true, "sha256": "44e914ad2780edabf2754f4fae734fd9b5811d6d8b5db094e57f6e379d0be0d4"}}, "sources": {"analysis_study.py": "\"\"\"Independent frozen-tensor audit, initialization moments and finite-window controls.\"\"\"\nimport argparse,json,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.constants import e,epsilon_0,c\nfrom estimator import estimate\np=argparse.ArgumentParser();p.add_argument('--case',action='append',nargs=3,metavar=('LABEL','DIRECTORY','PATCH'));a=p.parse_args()\nsummary={};records={}\nfor label,directory,patch in a.case:\n d=Path(directory);r=json.loads((d/'result.json').read_text());h=json.loads((d/'history.json').read_text());raw=np.load(d/'moments.npz');q=np.load(patch);m=json.loads(Path(patch).with_suffix('.json').read_text());species={}\n for sp in ['ions','electrons']:\n  est=estimate(raw,h,sp,window=(.4,.9));prs=np.array([raw[f\"step{x['step']}_{sp}_pressure\"] for x in h]);dens=np.array([raw[f\"step{x['step']}_{sp}_number_density\"] for x in h]);vel=np.array([raw[f\"step{x['step']}_{sp}_velocity\"] for x in h]);times=np.array([x['time_omegaci'] for x in h]);scalar=np.trace(prs,axis1=2,axis2=3).mean(axis=1)/3\n  sampling=[];shear=[];reconstruction=[];secondary_count_min=float(\"inf\");secondary_effective_min=float(\"inf\");secondary_finite=True\n  for row in h:\n   pre=f\"step{row['step']}_{sp}_\";P=raw[pre+'pressure'];tr=np.trace(P,axis1=1,axis2=2);eff=raw[pre+'effective_count']\n   if pre+'normalized_velocity_fourth_moment' in raw:\n    q4=raw[pre+'normalized_velocity_fourth_moment'];frob=np.sum(P*P,axis=(1,2))/tr**2\n    variance=np.maximum(0,3*(q4-frob)/eff)\n    sampling.append(float(2*np.sqrt(variance.sum())/len(eff)))\n   sub=f\"substep{row['step']}_{sp}_\"\n   if sub+'pressure' in raw:\n    if row['time_omegaci']>=.475:\n     secondary_count_min=min(secondary_count_min,float(raw[sub+'count'].min()));secondary_effective_min=min(secondary_effective_min,float(raw[sub+'effective_count'].min()));secondary_finite=secondary_finite and bool(np.isfinite(raw[sub+'pressure']).all() and np.all(np.trace(raw[sub+'pressure'],axis1=1,axis2=2)>0))\n    nb=r.get('secondary_bins',0);bp=r['moment_bins_per_axis'];assert nb==2*bp\n    Ps=raw[sub+'pressure'].reshape(nb,nb,3,3);ns=raw[sub+'number_density'].reshape(nb,nb);vs=raw[sub+'velocity'].reshape(nb,nb,3);mass=m['scales']['ion_mass_kg' if sp=='ions' else 'electron_mass_kg'];rec=[];frac=[]\n    for iz in range(bp):\n     for ix in range(bp):\n      sl=(slice(iz*2,iz*2+2),slice(ix*2,ix*2+2));n=ns[sl].reshape(4);v=vs[sl].reshape(4,3);mean=(n[:,None]*v).sum(0)/n.sum();dv=v-mean;S=mass*np.einsum('n,ni,nj->ij',n,dv,dv)/4;R=Ps[sl].reshape(4,3,3).mean(0)+S;rec.append(R);frac.append(np.linalg.norm(S)/(np.trace(R)/np.sqrt(3)))\n    reconstruction.append(float(np.linalg.norm(np.array(rec)-P)/np.linalg.norm(P)));shear.append(float(max(frac)))\n  est['sampling_two_sigma_estimate_max']=max(sampling) if sampling else None\n  est['secondary_eligible']=bool(secondary_finite and secondary_count_min>=128 and secondary_effective_min>=256) if reconstruction else None\n  est['secondary_minimum_count']=secondary_count_min if reconstruction else None\n  est['secondary_minimum_effective_count']=secondary_effective_min if reconstruction else None\n  est['secondary_coarse_tensor_reconstruction_rms_max']=max(reconstruction) if reconstruction else None\n  est['secondary_between_bin_velocity_pressure_upper_max']=max(shear) if shear else None\n  origin={key:float(max(raw[f\"step{x['step']}_{sp}_\"+key].max() for x in h)) for key in ['origin_outside_small_patch_fraction','origin_boundary_colla