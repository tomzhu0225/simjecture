&CONTROL
 calculation='scf',
 prefix='sample', outdir='./out',
 pseudo_dir='../pseudo',
 tstress=.true., tprnfor=.true.,
 etot_conv_thr=1e-06,
 forc_conv_thr=0.0001,
/
&SYSTEM
 ibrav=0, nat=1, ntyp=1,
 ecutwfc=60, ecutrho=300,
 input_dft='PBE', nspin=2,
 occupations='smearing',
