{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research_state",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "research-decision/1"
    },
    "task_contract": {
      "type": "object"
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "physical_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "equations": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validity_scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "equations",
          "assumptions",
          "validity_scope"
        ],
        "additionalProperties": false
      }
    },
    "available_resources": {
      "type": "object"
    },
    "completed_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "study_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "minLength": 1
          },
          "output_sha256": {
            "type": "string",
            "minLength": 1
          },
          "solver": {
            "type": "string",
            "minLength": 1
          },
          "solver_version": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "started_at": {
            "type": "number"
          },
          "finished_at": {
            "type": "number"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "timed_out",
              "partial"
            ]
          },
          "cost": {
            "type": "object",
            "properties": {
              "wall_seconds": {
                "type": "number",
                "minimum": 0
              },
              "cpu_core_seconds": {
                "type": "number",
                "minimum": 0
              },
              "gpu_seconds": {
                "type": "number",
                "minimum": 0
              },
              "npu_seconds": {
                "type": "number",
                "minimum": 0
              },
              "peak_memory_bytes": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "wall_seconds",
              "cpu_core_seconds",
              "gpu_seconds",
              "npu_seconds",
              "peak_memory_bytes"
            ],
            "additionalProperties": false
          },
          "diagnostics": {
            "type": "object"
          },
          "artifact_hashes": {
            "type": "object"
          }
        },
        "required": [
          "receipt_id",
          "task_id",
          "study_id",
          "decision_id",
          "input_sha256",
          "output_sha256",
          "solver",
          "solver_version",
          "source_sha256",
          "seed",
          "started_at",
          "finished_at",
          "status",
          "cost",
          "diagnostics",
          "artifact_hashes"
        ],
        "additionalProperties": false
      }
    },
    "verified_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "receipt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "measured_values": {
            "type": "object"
          },
          "uncertainty": {
            "type": "object"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "number"
          }
        },
        "required": [
          "evidence_id",
          "receipt_ids",
          "measured_values",
          "uncertainty",
          "scope",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "necessary_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "executed_plan": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "decision_id",
          "executed_plan",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "remaining_wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "observed_at": {
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "task_contract",
    "hypotheses",
    "physical_models",
    "available_resources",
    "completed_receipts",
    "verified_evidence",
    "necessary_history",
    "remaining_wall_seconds",
    "observed_at"
  ],
  "additionalProperties": false
}
