{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rl_trajectory",
  "type": "object",
  "properties": {
    "trajectory_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "const": "train"
    },
    "policy_sha256": {
      "type": "string",
      "minLength": 1
    },
    "initial_state_sha256": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "research-decision/1"
          },
          "task_contract": {
            "type": "object"
          },
          "hypotheses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "physical_models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "equations": {
                  "type": "string",
                  "minLength": 1
                },
                "assumptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "validity_scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "equations",
                "assumptions",
                "validity_scope"
              ],
              "additionalProperties": false
            }
          },
          "available_resources": {
            "type": "object"
          },
          "completed_receipts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "receipt_id": {
                  "type": "string",
                  "minLength": 1
                },
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "study_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "input_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "output_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "solver": {
                  "type": "string",
                  "minLength": 1
                },
                "solver_version": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "seed": {
                  "type": "integer"
                },
                "started_at": {
                  "type": "number"
                },
                "finished_at": {
                  "type": "number"
                },
                "status": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "cancelled",
                    "timed_out",
                    "partial"
                  ]
                },
                "cost": {
                  "type": "object",
                  "properties": {
                    "wall_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "cpu_core_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "gpu_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "npu_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "peak_memory_bytes": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "wall_seconds",
                    "cpu_core_seconds",
                    "gpu_seconds",
                    "npu_seconds",
                    "peak_memory_bytes"
                  ],
                  "additionalProperties": false
                },
                "diagnostics": {
                  "type": "object"
                },
                "artifact_hashes": {
                  "type": "object"
                }
              },
              "required": [
                "receipt_id",
                "task_id",
                "study_id",
                "decision_id",
                "input_sha256",
                "output_sha256",
                "solver",
                "solver_version",
                "source_sha256",
                "seed",
                "started_at",
                "finished_at",
                "status",
                "cost",
                "diagnostics",
                "artifact_hashes"
              ],
              "additionalProperties": false
            }
          },
          "verified_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "measured_values": {
                  "type": "object"
                },
                "uncertainty": {
                  "type": "object"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "observed_at": {
                  "type": "number"
                }
              },
              "required": [
                "evidence_id",
                "receipt_ids",
                "measured_values",
                "uncertainty",
                "scope",
                "observed_at"
              ],
              "additionalProperties": false
            }
          },
          "necessary_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "executed_plan": {
                  "type": "object"
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "decision_id",
                "executed_plan",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "remaining_wall_seconds": {
            "type": "number",
            "minimum": 0
          },
          "observed_at": {
            "type": "number"
          }
        },
        "required": [
          "schema_version",
          "task_contract",
          "hypotheses",
          "physical_models",
          "available_resources",
          "completed_receipts",
          "verified_evidence",
          "necessary_history",
          "remaining_wall_seconds",
          "observed_at"
        ],
        "additionalProperties": false
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "study_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "observation_sha256": {
            "type": "string",
            "minLength": 1
          },
          "original_advice": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "action": {
                    "enum": [
                      "propose_experiments",
                      "reorganize",
                      "request_evidence",
                      "closeout"
                    ]
                  },
                  "experiments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "experiment_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "scientific_question": {
                          "type": "string",
                          "minLength": 1
                        },
                        "competing_hypotheses": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "solver": {
                          "type": "string",
                          "minLength": 1
                        },
                        "physical_model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "parameters": {
                          "type": "object"
                        },
                        "initial_boundary_conditions": {
                          "type": "object"
                        },
                        "scale": {
                          "type": "object",
                          "properties": {
                            "spatial_dimensions": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 3
                            },
                            "mesh": {
                              "type": "object"
                            },
                            "particles": {
                              "type": "object"
                            },
                            "time_integration": {
                              "type": "object"
                            },
                            "parallel_resources": {
                              "type": "object"
                            },
                            "estimated_wall_seconds": {
                              "type": "number",
                              "minimum": 0
                            },
                            "expected_numerical_error": {
                              "type": "string",
                              "minLength": 1
                            },
                            "refinement_condition": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "spatial_dimensions",
                            "mesh",
                            "particles",
                            "time_integration",
                            "parallel_resources",
                            "estimated_wall_seconds",
                            "expected_numerical_error",
                            "refinement_condition"
                          ],
                          "additionalProperties": false
                        },
                        "diagnostics": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "success_or_falsification_criteria": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "dependencies": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "experiment_id",
                        "scientific_question",
                        "competing_hypotheses",
                        "solver",
                        "physical_model",
                        "parameters",
                        "initial_boundary_conditions",
                        "scale",
                        "diagnostics",
                        "success_or_falsification_criteria",
                        "dependencies",
                        "evidence_ids"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "organization": {
                    "type": "string",
                    "minLength": 1
                  },
                  "parameter_justification": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model_hierarchy": {
                    "type": "string",
                    "minLength": 1
                  },
                  "budget_allocation": {
                    "type": "object"
                  },
                  "public_justification": {
                    "type": "string",
                    "minLength": 1
                  },
                  "change_of_mind_conditions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "requested_evidence_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "action",
                  "experiments",
                  "organization",
                  "parameter_justification",
                  "model_hierarchy",
                  "budget_allocation",
                  "public_justification",
                  "change_of_mind_conditions",
                  "requested_evidence_ids"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "executed_plan": {
            "type": "object"
          },
          "component_sources": {
            "type": "object",
            "properties": {
              "experiment_selection": {
                "enum": [
                  "student",
                  "modified",
                  "host",
                  "unused"
                ]
              },
              "organization": {
                "enum": [
                  "student",
                  "modified",
                  "host",
                  "unused"
                ]
              },
              "parameters": {
                "enum": [
                  "student",
                  "modified",
                  "host",
                  "unused"
                ]
              },
              "model_hierarchy": {
                "enum": [
                  "student",
                  "modified",
                  "host",
                  "unused"
                ]
              },
              "scale": {
                "enum": [
                  "student",
                  "modified",
                  "host",
                  "unused"
                ]
              }
            },
            "required": [
              "experiment_selection",
              "organization",
              "parameters",
              "model_hierarchy",
              "scale"
            ],
            "additionalProperties": false
          },
          "override_reasons": {
            "type": "object"
          },
          "host_model": {
            "const": "gpt-6.1-sol"
          },
          "student_positive_credit_eligible": {
            "type": "boolean"
          },
          "retained_student_components": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scale_default": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "study_id",
          "decision_id",
          "observation_sha256",
          "original_advice",
          "executed_plan",
          "component_sources",
          "override_reasons",
          "host_model",
          "student_positive_credit_eligible",
          "retained_student_components",
          "scale_default"
        ],
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "study_id": {
            "type": "string",
            "minLength": 1
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "input_sha256": {
            "type": "string",
            "minLength": 1
          },
          "output_sha256": {
            "type": "string",
            "minLength": 1
          },
          "solver": {
            "type": "string",
            "minLength": 1
          },
          "solver_version": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          },
          "started_at": {
            "type": "number"
          },
          "finished_at": {
            "type": "number"
          },
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled",
              "timed_out",
              "partial"
            ]
          },
          "cost": {
            "type": "object",
            "properties": {
              "wall_seconds": {
                "type": "number",
                "minimum": 0
              },
              "cpu_core_seconds": {
                "type": "number",
                "minimum": 0
              },
              "gpu_seconds": {
                "type": "number",
                "minimum": 0
              },
              "npu_seconds": {
                "type": "number",
                "minimum": 0
              },
              "peak_memory_bytes": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "wall_seconds",
              "cpu_core_seconds",
              "gpu_seconds",
              "npu_seconds",
              "peak_memory_bytes"
            ],
            "additionalProperties": false
          },
          "diagnostics": {
            "type": "object"
          },
          "artifact_hashes": {
            "type": "object"
          }
        },
        "required": [
          "receipt_id",
          "task_id",
          "study_id",
          "decision_id",
          "input_sha256",
          "output_sha256",
          "solver",
          "solver_version",
          "source_sha256",
          "seed",
          "started_at",
          "finished_at",
          "status",
          "cost",
          "diagnostics",
          "artifact_hashes"
        ],
        "additionalProperties": false
      }
    },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "verified_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "process_reward": {
            "type": "number"
          },
          "terminal_reward": {
            "type": "number"
          },
          "student_credit": {
            "type": "number"
          },
          "credit_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "decision_id",
          "verified_evidence_ids",
          "process_reward",
          "terminal_reward",
          "student_credit",
          "credit_basis"
        ],
        "additionalProperties": false
      }
    },
    "closeout": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "falsified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "termination_reason": {
          "type": "string",
          "minLength": 1
        },
        "include_in_C": {
          "const": true
        },
        "include_in_D": {
          "const": true
        }
      },
      "required": [
        "supported",
        "falsified",
        "unresolved",
        "scope",
        "evidence_ids",
        "termination_reason",
        "include_in_C",
        "include_in_D"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "trajectory_id",
    "task_id",
    "split",
    "policy_sha256",
    "initial_state_sha256",
    "observations",
    "audits",
    "receipts",
    "rewards",
    "closeout"
  ],
  "additionalProperties": false
}
